# Renomeie para .env.prod e preencha com valores reais
# Gere SESSION_SECRET com: openssl rand -hex 32

DB_USER=fincontrol
DB_PASS=TROQUE_POR_SENHA_FORTE_AQUI
DB_NAME=fincontrol
SESSION_SECRET=TROQUE_POR_HASH_ALEATORIO_AQUI

# E-mail (recuperacao de senha e contas do mes). Para Gmail basta usuario + senha de app;
# servidor, porta e remetente tem padrao no codigo (ver documentacao/04-auth.md).
SMTP_USER=
SMTP_PASS=
